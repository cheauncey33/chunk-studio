{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chunk-studio.local/schemas/standard-value-audit-card-1.0.json",
  "title": "Standard Value Audit Card",
  "description": "A reproducible input contract for auditing one standard requirement in a test report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "card_id",
    "report",
    "sample_context",
    "test_context",
    "pending_rule"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "card_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_no", "document", "declared_bases"],
      "properties": {
        "report_no": {"type": "string", "minLength": 1},
        "document": {
          "type": "object",
          "additionalProperties": false,
          "required": ["document_name", "document_sha256", "format"],
          "properties": {
            "document_name": {"type": "string", "minLength": 1},
            "document_sha256": {"$ref": "#/$defs/sha256"},
            "format": {"enum": ["pdf", "mineru_markdown", "other"]}
          }
        },
        "declared_bases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/declaredBasis"}
        }
      }
    },
    "sample_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts"],
      "properties": {
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/contextFact"}
        }
      }
    },
    "test_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_code", "project_name", "facts", "source"],
      "properties": {
        "project_code": {
          "enum": [
            "induced_withstand_voltage",
            "applied_withstand_voltage",
            "no_load_loss",
            "load_loss"
          ]
        },
        "project_name": {"type": "string", "minLength": 1},
        "occurrence": {"type": "string", "minLength": 1},
        "facts": {
          "type": "array",
          "items": {"$ref": "#/$defs/contextFact"}
        },
        "source": {"$ref": "#/$defs/sourceLocation"}
      }
    },
    "pending_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "parameter_code",
        "parameter_name",
        "raw_text",
        "origin",
        "normalized_claim",
        "source"
      ],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "parameter_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "parameter_name": {"type": "string", "minLength": 1},
        "raw_text": {"type": "string", "minLength": 1},
        "origin": {"enum": ["extracted", "normalized", "counterfactual", "user_supplied"]},
        "derivation": {"type": "string", "minLength": 1},
        "normalized_claim": {"$ref": "#/$defs/normalizedClaim"},
        "source": {"$ref": "#/$defs/sourceLocation"}
      },
      "allOf": [
        {
          "if": {"properties": {"origin": {"enum": ["normalized", "counterfactual"]}}},
          "then": {"required": ["derivation"]}
        }
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bbox": {
      "type": "array",
      "description": "Normalized [x1, y1, x2, y2] coordinates.",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_name", "location_quality", "text_quote"],
      "properties": {
        "document_name": {"type": "string", "minLength": 1},
        "document_sha256": {"$ref": "#/$defs/sha256"},
        "page": {"type": "integer", "minimum": 1},
        "bbox": {"$ref": "#/$defs/bbox"},
        "block_index": {"type": "integer", "minimum": 0},
        "markdown_line": {"type": "integer", "minimum": 1},
        "section": {"type": "string", "minLength": 1},
        "text_quote": {"type": "string", "minLength": 1},
        "location_quality": {"enum": ["exact", "partial"]},
        "parser": {"type": "string", "minLength": 1},
        "parse_id": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {"required": ["page"]},
        {"required": ["markdown_line"]},
        {"required": ["section"]}
      ]
    },
    "declaredBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis_id", "title", "role", "availability", "source"],
      "properties": {
        "basis_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "standard_no": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "role": {"enum": ["tender_specification", "standard", "referenced_standard", "other"]},
        "availability": {"enum": ["available", "missing", "unresolved"]},
        "source": {"$ref": "#/$defs/sourceLocation"}
      }
    },
    "contextFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value", "raw_text", "origin", "source"],
      "properties": {
        "field": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "value": {
          "oneOf": [
            {"type": "string"},
            {"type": "number"},
            {"type": "boolean"},
            {"type": "array", "items": {"type": ["string", "number", "boolean"]}}
          ]
        },
        "unit": {"type": "string", "minLength": 1},
        "raw_text": {"type": "string", "minLength": 1},
        "origin": {"enum": ["extracted", "normalized", "derived", "user_supplied"]},
        "derivation": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/sourceLocation"}
      },
      "allOf": [
        {
          "if": {"required": ["origin"], "properties": {"origin": {"enum": ["normalized", "derived"]}}},
          "then": {"required": ["derivation"]}
        }
      ]
    },
    "normalizedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operator"],
      "properties": {
        "kind": {"enum": ["scalar_limit", "interval", "relative", "formula", "qualitative", "unknown"]},
        "operator": {"enum": ["eq", "lt", "lte", "gt", "gte", "between", "formula", "text_equals", "unknown"]},
        "value": {"type": ["number", "string", "boolean"]},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "minimum_inclusive": {"type": "boolean"},
        "maximum_inclusive": {"type": "boolean"},
        "unit": {"type": "string", "minLength": 1},
        "expression": {"type": "string", "minLength": 1},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "scalar_limit"}}},
          "then": {"required": ["value"]}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "interval"}}},
          "then": {"required": ["minimum", "maximum", "minimum_inclusive", "maximum_inclusive"]}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "formula"}}},
          "then": {"required": ["expression"]}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "qualitative"}}},
          "then": {"required": ["value"]}
        }
      ]
    }
  }
}
