{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retrieval_ground_truth_v2.schema.json",
  "title": "Retrieval ground truth review draft v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "unit_of_evaluation",
    "evidence_semantics",
    "evaluation_profiles",
    "source_artifacts",
    "summary",
    "cases"
  ],
  "properties": {
    "version": {"const": 2},
    "status": {"const": "draft_pending_domain_review"},
    "unit_of_evaluation": {"const": "one reported detection requirement"},
    "evidence_semantics": {"type": "string", "minLength": 1},
    "evaluation_profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lenient_relevance", "strict_answer"],
      "properties": {
        "lenient_relevance": {"$ref": "#/$defs/evaluation_profile"},
        "strict_answer": {"$ref": "#/$defs/evaluation_profile"}
      }
    },
    "source_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_pool", "legacy_candidate_review", "legacy_evidence_groups"],
      "properties": {
        "case_pool": {"type": "string", "minLength": 1},
        "legacy_candidate_review": {"type": "string", "minLength": 1},
        "legacy_evidence_groups": {"type": "string", "minLength": 1}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "retrieval_answerable_candidates",
        "context_required_cases",
        "deterministic_prefilter_cases",
        "required_evidence_groups",
        "deterministic_context_groups",
        "evidence_locator_assignments",
        "unique_evidence_chunks",
        "deterministic_context_locator_assignments",
        "unique_deterministic_context_chunks",
        "relevant_locator_assignments",
        "unique_relevant_chunks",
        "pending_domain_review_cases",
        "scoreable_case_count",
        "legacy_direct_missing_conflicts",
        "resolved_legacy_direct_missing_conflicts"
      ],
      "properties": {
        "case_count": {"type": "integer", "minimum": 0},
        "retrieval_answerable_candidates": {"type": "integer", "minimum": 0},
        "context_required_cases": {"type": "integer", "minimum": 0},
        "deterministic_prefilter_cases": {"type": "integer", "minimum": 0},
        "required_evidence_groups": {"type": "integer", "minimum": 0},
        "deterministic_context_groups": {"type": "integer", "minimum": 0},
        "evidence_locator_assignments": {"type": "integer", "minimum": 0},
        "unique_evidence_chunks": {"type": "integer", "minimum": 0},
        "deterministic_context_locator_assignments": {"type": "integer", "minimum": 0},
        "unique_deterministic_context_chunks": {"type": "integer", "minimum": 0},
        "relevant_locator_assignments": {"type": "integer", "minimum": 0},
        "unique_relevant_chunks": {"type": "integer", "minimum": 0},
        "pending_domain_review_cases": {"type": "integer", "minimum": 0},
        "scoreable_case_count": {"type": "integer", "minimum": 0},
        "legacy_direct_missing_conflicts": {"type": "integer", "minimum": 0},
        "resolved_legacy_direct_missing_conflicts": {"type": "integer", "minimum": 0}
      }
    },
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "dataset_split",
        "retrieval_class",
        "detection_project",
        "evaluation_scope",
        "answerability_status",
        "missing_context_fields",
        "relevant_evidence",
        "required_evidence_groups",
        "deterministic_context_evidence",
        "review",
        "legacy_review_context"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "dataset_split": {"enum": ["development", "validation", "test"]},
        "retrieval_class": {"type": "string", "minLength": 1},
        "detection_project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_name", "reported_requirement", "sample_context"],
          "properties": {
            "project_name": {"type": "string", "minLength": 1},
            "reported_requirement": {"type": "object"},
            "sample_context": {"type": "object"}
          }
        },
        "evaluation_scope": {"enum": ["retrieval", "deterministic_prefilter"]},
        "answerability_status": {
          "enum": ["answerable_candidate", "context_required", "not_applicable_to_retrieval"]
        },
        "missing_context_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "relevant_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_alternative"}
        },
        "required_evidence_groups": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_group"}
        },
        "deterministic_context_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/deterministic_context"}
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "migration_basis", "flags"],
          "properties": {
            "status": {"enum": ["pending_domain_review", "human_approved", "rejected"]},
            "migration_basis": {"type": "string", "minLength": 1},
            "flags": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "legacy_review_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gold_status",
            "direct_candidate_count",
            "supporting_candidate_count",
            "uncertain_count",
            "missing_evidence",
            "review_note",
            "recovery_note"
          ],
          "properties": {
            "gold_status": {"type": "string"},
            "direct_candidate_count": {"type": "integer", "minimum": 0},
            "supporting_candidate_count": {"type": "integer", "minimum": 0},
            "uncertain_count": {"type": "integer", "minimum": 0},
            "missing_evidence": {"type": "string"},
            "review_note": {"type": "string"},
            "recovery_note": {"type": "string"}
          }
        }
      }
    },
    "evidence_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "requirement", "alternatives"],
      "properties": {
        "group_id": {"type": "string", "minLength": 1},
        "requirement": {"type": "string", "minLength": 1},
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_alternative"}
        }
      }
    },
    "evidence_alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "evidence_quote",
        "quote_verified",
        "reason",
        "legacy_label",
        "discovery_method"
      ],
      "properties": {
        "locator": {"$ref": "#/$defs/locator"},
        "evidence_quote": {"type": "string"},
        "quote_verified": {"type": "boolean"},
        "reason": {"type": "string"},
        "legacy_label": {"enum": ["direct_candidate", "supporting_candidate"]},
        "discovery_method": {"type": "string", "minLength": 1}
      }
    },
    "deterministic_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "application_rule", "alternatives"],
      "properties": {
        "context_id": {"type": "string", "minLength": 1},
        "application_rule": {"type": "string", "minLength": 1},
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_alternative"}
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard_no",
        "content_type",
        "page_start",
        "page_end",
        "text_sha256"
      ],
      "properties": {
        "standard_no": {"type": "string", "minLength": 1},
        "content_type": {"enum": ["table", "section"]},
        "page_start": {"type": "integer", "minimum": 1},
        "page_end": {"type": "integer", "minimum": 1},
        "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "section": {"type": "string"},
        "section_title": {"type": "string"},
        "table_no": {"type": "string"},
        "table_title": {"type": "string"}
      }
    },
    "evaluation_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "evidence_field", "primary", "description"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "evidence_field": {"type": "string", "minLength": 1},
        "primary": {"type": "boolean"},
        "description": {"type": "string", "minLength": 1}
      }
    }
  }
}
