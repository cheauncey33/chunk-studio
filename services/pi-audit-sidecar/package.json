    "test": "node --import tsx --test src/preview.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.19.0",
    "typescript": "5.6"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
