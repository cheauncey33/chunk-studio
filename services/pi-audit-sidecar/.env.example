# Pi audit sidecar configuration (copy to .env and fill in).
# LLM: 智谱官方 OpenAI 兼容。API Key 来自 https://open.bigmodel.cn
PI_API_KEY=
PI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
PI_MODEL=glm-5.3-flash
PI_PROVIDER=zhipu
# GLM-5.3 仅 low/high/max（不可关思考）。审查默认 low。
PI_THINKING_LEVEL=low

# chunk-studio backend the RAG tools call.
CHUNK_STUDIO_API_BASE=http://127.0.0.1:8000

# HTTP server
PORT=8787
# Optional shared secret; when set, callers must send "Authorization: Bearer <token>".
AGENT_SIDECAR_TOKEN=

# 智谱官方 glm-5.3-flash 可并行多路；默认 5。
AGENT_CONCURRENCY=5
# Hard wall-clock budget for one case (agent loop + retries inside).
AGENT_CASE_TIMEOUT_MS=420000
# Tool-call budget per case (host-side hook + tool execute hard cap).
# Qwen flash typically uses ~6 search + 3 read; 8 was too tight and the Pi
# tool_call hook did not always fire, so default is 12 with execute-level cap.
PI_MAX_TOOL_CALLS=12

# Per-case trace JSONL directory (auto-pruned to TRACE_KEEP files).
TRACE_DIR=./traces
TRACE_KEEP=200
